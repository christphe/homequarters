{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Quarters",
  "version": "0.1.0",
  "identifier": "app.homequarters.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "Business",
    "shortDescription": "A 2D virtual office",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MzA5RUREMkNBQzM2RjUKUldUMU5xd3MzWjR3WlJHWGNpV0M0eXBmZ2FZdEhabm1EZlQrNzg5Qk03djBCRThQcjJmdVMvTXkK",
      "endpoints": [
        "https://github.com/christphe/homequarters/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
