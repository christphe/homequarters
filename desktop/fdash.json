{
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "."
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "ui",
          "src-tauri/src"
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "lint:rust": {
      "cwd": "src-tauri",
      "run": [
        [
          "cargo",
          "fmt",
          "--check"
        ],
        [
          "cargo",
          "clippy",
          "--all-targets",
          "--locked",
          "--",
          "-D",
          "warnings"
        ]
      ],
      "inputs": [
        "ui/**",
        "src-tauri/**",
        "!src-tauri/target/**",
        "!src-tauri/gen/**"
      ],
      "tools": [
        [
          "cargo",
          "--version"
        ],
        [
          "cargo",
          "clippy",
          "--version"
        ]
      ]
    }
  }
}
