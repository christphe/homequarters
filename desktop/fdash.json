{
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "."
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "ui",
          "src-tauri/src"
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    }
  }
}
