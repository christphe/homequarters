{
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/package.json",
        "/pnpm-workspace.yaml",
        "/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "test/*.test.ts"
        ]
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ]
    }
  }
}
