{
  "tasks": {
    "lint": {
      "run": [
        [
          "node",
          "../../web/node_modules/typescript/bin/tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml"
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "test/*.test.ts"
        ]
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ]
    }
  }
}
