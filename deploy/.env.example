# Copy to deploy/.env. Never commit the real file.
APP_DOMAIN=office.example.com
LIVEKIT_DOMAIN=rtc.example.com
OFFICE_NAME=My Office
# generate:  openssl rand -hex 8   /   openssl rand -hex 32
LIVEKIT_API_KEY=changeme-key
LIVEKIT_API_SECRET=changeme-secret-at-least-32-characters-long
# optional: enables /metrics for Prometheus (bearer token, at least 16 characters). Without it /metrics is disabled.
# generate:  openssl rand -hex 16
METRICS_TOKEN=
# Public demo mode: anyone joins without an invite (as a member), office content resets every DEMO_RESET_HOURS.
# Leave empty for a private office. Recommended with a demo: MAX_PLAYERS=60, SESSION_DAYS=1.
DEMO=
DEMO_RESET_HOURS=6
MAX_PLAYERS=2000
SESSION_DAYS=30
# Sign-in: none (invite links, the cookie is the account) or google. See "Sign in with Google" in deploy/README.md.
AUTH_PROVIDERS=none
# Workspace domains whose accounts enter without an invite, comma separated (others need an invite).
AUTH_DOMAINS=
# The Google OAuth client (type Web application, redirect https://APP_DOMAIN/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who runs this office and an address for questions about personal data, shown on https://APP_DOMAIN/privacy.
OPERATOR=
CONTACT=
# Optional overrides for an existing installation; see "Upgrading to Tilework" in deploy/README.md.
# TILEWORK_IMAGE=ghcr.io/guhcostan/tilework:latest
# TILEWORK_DB=/data/tilework.db
# TILEWORK_DATA_VOLUME=tilework_tilework-data
# TILEWORK_CADDY_DATA_VOLUME=tilework_caddy-data
# TILEWORK_CADDY_CONFIG_VOLUME=tilework_caddy-config
