{
  "files": [
    "**",
    "!test/**",
    "!dev/**"
  ],
  "dependsOn": [
    "sdk"
  ],
  "tasks": {
    "tsc": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "--noEmit"
        ]
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "tsc-tests": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json",
          "--noEmit"
        ]
      ],
      "inputs": [
        "/tools/fdash/**",
        "/scripts/**",
        "/plugins/**",
        "/e2e/shards.ts"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "tsc-sdk": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.sdk.json"
        ]
      ],
      "inputs": [
        "/plugins/sdk/client.d.ts",
        "/plugins/sdk/view.d.ts"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "build": {
      "run": [
        [
          "pnpm",
          "exec",
          "vite",
          "build"
        ]
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test": {
      "run": [
        [
          "node",
          "--test",
          "test/*.test.ts"
        ]
      ],
      "inputs": [
        "/server/internal/gamemap/map.go",
        "/server/internal/httpapi/avatar.go"
      ]
    }
  }
}
