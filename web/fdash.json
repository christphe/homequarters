{
  "files": [
    "**",
    "!test/**",
    "!dev/**"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "--noEmit"
        ],
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json",
          "--noEmit"
        ],
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.sdk.json"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "src",
          "test"
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml",
        "/plugins/sdk/client.d.ts",
        "/plugins/sdk/view.d.ts"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "build": {
      "run": [
        [
          "pnpm",
          "exec",
          "vite",
          "build"
        ]
      ],
      "outputs": [
        "dist/**"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "test/*.test.ts"
        ]
      ],
      "inputs": [
        "/server/internal/gamemap/map.go",
        "/server/internal/httpapi/avatar.go"
      ]
    }
  }
}
