# Copy to .env (git-ignored) at the repository root and fill it in. The e2e suite (e2e/run.mjs) and the art
# scripts read it; a variable already set in the environment wins over this file. A worktree without its own
# .env reads the main checkout's.

# Most local e2e runs (or E2E_PARALLELISM shards) on this machine at once, across every checkout and
# worktree; a run waits for a free slot. Each run is a Go server, a LiveKit and Chrome.
E2E_MAX_PARALLEL=2

# Chrome for the e2e suite and the art scripts. Required: nothing is guessed. Usual paths:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#            C:\Program Files (x86)\Google\Chrome\Application\chrome.exe
#            %LOCALAPPDATA%\Google\Chrome\Application\chrome.exe (installed for one user; write the path out)
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
#            /usr/bin/google-chrome-stable
#            /usr/bin/chromium
CHROME=
