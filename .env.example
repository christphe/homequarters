# Copy to .env (git-ignored) and adjust. e2e/run.mjs reads it; a variable already set in the environment
# wins over this file. A worktree without its own .env reads the main checkout's.

# Most local e2e runs (or E2E_PARALLELISM shards) on this machine at once, across every checkout and
# worktree; a run waits for a free slot (default 2). Each run is a Go server, a LiveKit and Chrome.
E2E_MAX_PARALLEL=2

# Chrome for the e2e suite and the art scripts (default: the macOS path).
# CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME=/usr/bin/google-chrome
