{
  "projects": [
    "server",
    "web",
    "site",
    "e2e",
    "docs",
    "desktop",
    "scripts",
    "tools/fdash",
    "plugins/sdk",
    "plugins/bundled/*",
    "plugins/e2e/*"
  ],
  "tasks": {
    "default": {
      "jobs": 1,
      "tasks": [
        "static",
        "integration",
        "browser"
      ]
    },
    "static": {
      "tasks": [
        "lint",
        "lint:repo",
        "build",
        "test:unit"
      ]
    },
    "integration": {
      "tasks": [
        "test:integration"
      ]
    },
    "browser": {
      "jobs": 1,
      "tasks": [
        "test:e2e"
      ]
    },
    "lint:repo": {
      "tasks": [
        "lint:actions",
        "lint:secrets",
        "lint:shell",
        "lint:docker"
      ]
    },
    "lint:actions": {
      "run": [
        [
          "node",
          "scripts/lint-repo.ts",
          "actions"
        ]
      ],
      "inputs": [
        ".github/**",
        "scripts/lint-repo.ts",
        "scripts/tools.ts",
        "tools/go/actionlint/go.mod",
        "tools/go/actionlint/go.sum"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ]
    },
    "lint:secrets": {
      "run": [
        [
          "node",
          "scripts/lint-repo.ts",
          "secrets"
        ]
      ],
      "inputs": [
        "**"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ]
    },
    "lint:shell": {
      "run": [
        [
          "node",
          "scripts/lint-repo.ts",
          "shell"
        ]
      ],
      "inputs": [
        "**/*.sh",
        "scripts/lint-repo.ts",
        "scripts/tools.ts"
      ]
    },
    "lint:docker": {
      "run": [
        [
          "node",
          "scripts/lint-repo.ts",
          "docker"
        ]
      ],
      "inputs": [
        "deploy/Dockerfile",
        "scripts/lint-repo.ts",
        "scripts/tools.ts"
      ]
    }
  }
}
