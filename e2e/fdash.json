{
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "--noEmit"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/critters/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/drawn-pet/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/drawn-pet/public/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/drawn-sheet/public/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/ui-demo/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/ui-demo/public/tsconfig.json"
        ],
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "fixtures/plugins/installed/ui-demo/public/views/tsconfig.json"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/web/src/**",
        "/web/package.json",
        "/web/pnpm-lock.yaml",
        "/plugins/bundled/*/public/**",
        "/plugins/sdk/**",
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "shards.test.ts",
          "slots.test.ts"
        ]
      ],
      "inputs": [
        "/plugins/e2e/*/fdash.json"
      ]
    },
    "test:e2e": {
      "run": [
        [
          "node",
          "run.ts"
        ]
      ],
      "env": {
        "E2E_VIEWPORT": "small",
        "E2E_PREBUILT": "1"
      },
      "args": true,
      "inputs": [
        "!scenarios/**",
        "!*.test.ts",
        "!plugin-run.ts",
        {
          "go": "./cmd/homequarters",
          "cwd": "../server"
        },
        "/web/**",
        "!/web/test/**",
        "!/web/dev/**",
        "/plugins/bundled/*/plugin.json",
        "/plugins/sdk/**",
        {
          "disk": "/bin/homequarters*"
        },
        {
          "disk": "/web/dist/**"
        }
      ],
      "envKeys": [
        "E2E_VIEWPORT",
        "HQ_EXTERNAL_URL",
        "HQ_MEDIA_TOKEN_TTL_SECONDS",
        "HQ_MEDIA_RECONCILE_SECONDS",
        "CHROME_VERSION",
        "SKIP_BUILD",
        "CI",
        "HQ_TEST_LK_PORT",
        "GOFLAGS",
        "CGO_ENABLED"
      ],
      "tools": [
        [
          "go",
          "version"
        ],
        [
          "pnpm",
          "--version"
        ],
        [
          "livekit-server",
          "--version"
        ]
      ],
      "items": {
        "proximity": {
          "inputs": [
            "scenarios/proximity.ts"
          ]
        },
        "consent": {
          "inputs": [
            "scenarios/consent.ts"
          ]
        },
        "rooms": {
          "inputs": [
            "scenarios/rooms.ts"
          ]
        },
        "access": {
          "inputs": [
            "scenarios/access.ts"
          ]
        },
        "editor": {
          "inputs": [
            "scenarios/editor.ts"
          ]
        },
        "social": {
          "inputs": [
            "scenarios/social.ts"
          ]
        },
        "admin": {
          "inputs": [
            "scenarios/admin.ts"
          ]
        },
        "plugins": {
          "inputs": [
            "scenarios/plugins.ts",
            "/plugins/bundled/**"
          ]
        },
        "a11y": {
          "inputs": [
            "scenarios/a11y.ts",
            "/plugins/bundled/**"
          ]
        },
        "security": {
          "inputs": [
            "scenarios/security.ts"
          ]
        },
        "resilience": {
