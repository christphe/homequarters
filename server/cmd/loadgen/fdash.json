{
  "dependsOn": [
    {
      "goMod": "go.mod"
    }
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "go",
          "tool",
          "-modfile=../../../tools/go/golangci-lint/go.mod",
          "golangci-lint",
          "run",
          "./..."
        ]
      ],
      "inputs": [
        "/.golangci.yml",
        "/tools/go/golangci-lint/go.mod",
        "/tools/go/golangci-lint/go.sum"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    },
    "lint:vuln": {
      "run": [
        [
          "go",
          "tool",
          "-modfile=../../../tools/go/govulncheck/go.mod",
          "govulncheck",
          "./..."
        ]
      ],
      "inputs": [
        "/tools/go/govulncheck/go.mod",
        "/tools/go/govulncheck/go.sum"
      ],
      "tools": [
        [
          "go",
          "version"
        ],
        [
          "node",
          "-e",
          "console.log('vulnerability database of ' + new Date().toISOString().slice(0, 10))"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    },
    "build": {
      "run": [
        [
          "go",
          "build",
          "-o",
          "../../../bin/",
          "."
        ]
      ],
      "outputs": [
        "/bin/loadgen*"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    },
    "test:unit": {
      "run": [
        [
          "go",
          "test",
          "-race",
          "-count=1",
          "./..."
        ]
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    }
  }
}
