{
  "tasks": {
    "lint": {
      "run": [
        [
          "gofmt",
          "-l",
          "."
        ],
        [
          "go",
          "vet",
          "./..."
        ],
        [
          "go",
          "tool",
          "staticcheck",
          "./..."
        ]
      ],
      "failOnOutput": true,
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    },
    "build": {
      "run": [
        [
          "go",
          "build",
          "-o",
          "../bin/",
          "./cmd/homequarters"
        ]
      ],
      "outputs": [
        "/bin/homequarters*"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    },
    "test:unit": {
      "run": [
        [
          "go",
          "test",
          "-race",
          "-count=1",
          "./..."
        ]
      ],
      "inputs": [
        "/plugins/**",
        "/web/dev/**"
      ],
      "tools": [
        [
          "go",
          "version"
        ]
      ],
      "envKeys": [
        "GOFLAGS",
        "CGO_ENABLED",
        "GOEXPERIMENT",
        "GOARCH",
        "GOOS"
      ]
    }
  }
}
