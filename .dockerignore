# Keep the build context small and never ship local databases, logs or dependencies.
.git
**/node_modules
web/dist
site/dist
server/data
**/*.db
**/*.db-*
.run
bin
bench
e2e
site
docs
deploy/.env
# plugin tests and their fixture plugins stay out of the image (plugins/bundled/ is copied whole)
plugins/bundled/*/test
# their package.json and vitest.config.ts only serve their lint and tests (pnpm workspace)
plugins/bundled/*/package.json
plugins/bundled/*/vitest.config.ts
# a contributor's go.work and binaries built in a module folder (decision 0041)
**/go.work
**/go.work.sum
server/cmd/*/homequarters
server/cmd/*/homequarters.exe
server/cmd/*/loadgen
server/cmd/*/loadgen.exe
