{
  "dependsOn": [
    "fdash"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/tools/fdash/**",
        "/e2e/shards.ts",
        "/package.json",
        "/pnpm-workspace.yaml",
        "/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "oxlint-hq.test.ts",
          "oxlint.test.ts",
          "check-protocol-docs.test.ts",
          "gauntlet.test.ts",
          "ci-fdash-records.test.ts"
        ]
      ],
      "inputs": [
        "/**"
      ]
    }
  }
}
