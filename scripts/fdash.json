{
  "dependsOn": [
    "fdash"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/tools/fdash/**",
        "/e2e/shards.ts",
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        },
        {
          "pnpm": "../tools/fdash"
        },
        {
          "pnpm": "../e2e"
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "pnpm",
          "exec",
          "vitest",
          "run"
        ]
      ],
      "inputs": [
        "/**"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    }
  }
}
