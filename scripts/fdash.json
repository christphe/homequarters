{
  "dependsOn": [
    "fdash"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "node",
          "../web/node_modules/typescript/bin/tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml",
        "/tools/fdash/**",
        "/e2e/shards.ts"
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "oxlint-hq.test.ts",
          "oxlint.test.ts",
          "check-protocol-docs.test.ts",
          "gauntlet.test.ts",
          "ci-fdash-records.test.ts"
        ]
      ],
      "inputs": [
        "/**"
      ]
    }
  }
}
