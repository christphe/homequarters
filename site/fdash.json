{
  "tasks": {
    "tsc": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "--noEmit"
        ]
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "build": {
      "run": [
        [
          "node",
          "build.ts"
        ],
        [
          "node",
          "check.ts"
        ]
      ],
      "inputs": [
        "/**"
      ]
    }
  }
}
