{
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "--noEmit"
        ],
        [
          "node",
          "../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "build": {
      "run": [
        [
          "node",
          "build.ts"
        ]
      ],
      "inputs": [
        "/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "check.ts"
        ]
      ],
      "after": [
        "build"
      ],
      "inputs": [
        "/**"
      ]
    }
  }
}
