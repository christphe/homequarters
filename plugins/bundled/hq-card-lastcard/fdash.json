{
  "dependsOn": [
    "server",
    "hq-cards",
    "sdk"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "node",
          "../../../web/node_modules/typescript/bin/tsc",
          "-p",
          "tsconfig.json"
        ],
        [
          "node",
          "../../../web/node_modules/typescript/bin/tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml",
        "/plugins/sdk/testbed.ts",
        "/plugins/sdk/server.d.ts",
        "/plugins/bundled/hq-cards/test/**",
        "/plugins/bundled/hq-cards/public/**"
      ]
    },
    "test:unit": {
      "run": [
        [
          "node",
          "--test",
          "test/*.test.ts"
        ]
      ]
    },
    "test:integration": {
      "run": [
        [
          "node",
          "--test",
          "**/*.ispec.ts"
        ]
      ],
      "inputs": [
        {
          "disk": "/bin/homequarters*"
        }
      ],
      "envKeys": [
        "HQ_BIN"
      ]
    }
  }
}
