{
  "dependsOn": [
    "server",
    "hq-cards",
    "sdk"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.json"
        ],
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/plugins/sdk/testbed.ts",
        "/plugins/sdk/server.d.ts",
        "/plugins/bundled/hq-cards/test/**",
        "/plugins/bundled/hq-cards/public/**",
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        },
        {
          "pnpm": "../hq-cards"
        },
        {
          "pnpm": "../../sdk"
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:unit": {
      "run": [
        [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "hq-card-lastcard"
        ]
      ],
      "inputs": [
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        },
        {
          "pnpm": "../hq-cards"
        },
        {
          "pnpm": "../../sdk"
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:integration": {
      "run": [
        [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "hq-card-lastcard:integration"
        ]
      ],
      "inputs": [
        {
          "disk": "/bin/homequarters*"
        },
        "/package.json",
        "/pnpm-workspace.yaml",
        {
          "pnpm": "."
        },
        {
          "pnpm": "../hq-cards"
        },
        {
          "pnpm": "../../sdk"
        }
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ],
      "env": {
        "HQ_BIN_REPO_ONLY": "1"
      }
    }
  }
}
