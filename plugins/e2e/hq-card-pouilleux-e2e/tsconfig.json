{
  // The Old Maid browser scenario (with the table's helpers, plugins/e2e/hq-cards-e2e/lib.ts), run by Node as it is
  // (type stripping) through e2e/plugin-run.ts: the same options as e2e/tsconfig.json. Its types
  // come from its package.json (Node) and e2e's (puppeteer-core, through e2e/lib.ts).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["*.ts", "../../../e2e/globals.d.ts"]
}
