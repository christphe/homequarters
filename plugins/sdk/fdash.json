{
  "name": "sdk",
  "dependsOn": [
    "server"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "pnpm",
          "exec",
          "tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/package.json",
        "/pnpm-workspace.yaml",
        "/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ]
    },
    "test:integration": {
      "run": [
        [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "sdk:integration"
        ]
      ],
      "inputs": [
        {
          "disk": "/bin/homequarters*"
        },
        "/package.json",
        "/pnpm-workspace.yaml",
        "/pnpm-lock.yaml"
      ],
      "tools": [
        [
          "pnpm",
          "--version"
        ]
      ],
      "env": {
        "HQ_BIN_REPO_ONLY": "1"
      }
    }
  }
}
