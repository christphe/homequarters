{
  "name": "sdk",
  "dependsOn": [
    "server"
  ],
  "tasks": {
    "lint": {
      "run": [
        [
          "node",
          "../../web/node_modules/typescript/bin/tsc",
          "-p",
          "tsconfig.test.json"
        ],
        [
          "node",
          "../../scripts/oxlint.ts",
          "."
        ]
      ],
      "inputs": [
        "/scripts/oxlint.ts",
        "/scripts/oxlint-hq.ts",
        "/.oxlintrc.json",
        "/web/package.json",
        "/web/pnpm-lock.yaml"
      ]
    },
    "test:integration": {
      "run": [
        [
          "node",
          "--test",
          "**/*.ispec.ts"
        ]
      ],
      "inputs": [
        {
          "disk": "/bin/homequarters*"
        }
      ],
      "env": {
        "HQ_BIN_REPO_ONLY": "1"
      }
    }
  }
}
